# Copy to .env and fill in:   cp .env.example .env
# scripts/run_local.sh loads it. Never commit .env (it is in .gitignore).
# At startup the server prints which keys it found and names any missing required key.

# ---------------------------------------------------------------- required for a conversation
# OpenAI API key with Realtime access. The default voice (GPT Realtime, ?voice=realtime) and the
# server-relayed voice (?voice=hub) use it. Without it the page and the 3D avatar still load, but
# starting a conversation fails with "Missing OPENAI_API_KEY".
# Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------- optional
# Gemini Live voice (?voice=gemini); also the last-choice planner route. GOOGLE_API_KEY is accepted instead.
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Move planner ("do a backflip" -> keyframes), chalkboard brain, wall-TV agent, feelings classifier.
# Used when the `claude` CLI (Claude Code) is NOT installed; with the CLI on PATH those run through it
# instead and this key is not needed. Without either: the planner falls back to OpenRouter / OpenAI
# (below) and the chalkboard + TV stay off.
# Get one: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Planner fallback (Gemini Flash Lite / DeepSeek via OpenRouter), behavior coder and attention judge.
# Without it those use OPENAI_API_KEY.
# Get one: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only for the optional planner route "meta" (Meta Llama API).
# Get one: https://llama.developer.meta.com
META_API_KEY=

# Path to the `claude` CLI if it is not on PATH (default: `claude`).
AVATAR_CLAUDE_BIN=

# ---------------------------------------------------------------- runtime knobs (defaults are fine)
# Listen address. Default 127.0.0.1:10250. (Variables already set in your shell win over .env.)
# HOST=127.0.0.1
# PORT=10250
# Where state/ (config.json, the page secret) and data/ live. run_local.sh defaults it to ./.avatar-home
AVATAR_HOME=
# Where session recordings go when you open the page with ?rec=1 (off by default).
# Default: <repo>/recordings/avatar-sessions
AVATAR_REC_ROOT=
# "cpu" forces the CPU (Mesa llvmpipe) render path; leave empty to use the GPU.
AVATAR_RT_DEVICE=
# 1 = refuse to start when OPENAI_API_KEY is missing (default: warn and start).
AVATAR_REQUIRE_KEYS=
# Planner model override: a preset (haiku55door, haiku55api, gem35lite, gpt54mini, …) or "auto" (default).
AVATAR_PLANNER_MODEL=
